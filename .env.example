# Copy to .env and fill in. Never commit .env.
MODEL_API_KEY=
SISI_MODEL=muse-spark-1.3-contributor
SISI_LANGUAGE_BIAS=English
SISI_REASONING_EFFORT=low
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v26.0
VERIFY_TOKEN=
APP_SECRET=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_WHATSAPP_FROM=14157386102
# Infobip WhatsApp (alternative provider). The API key lives in the Modal
# secret sisi-env as INFOBIP_API_KEY; add the rest there too (dashboard edit,
# never --from-dotenv unless .env mirrors the secret fully). Never commit
# real values. Base URL is per-account and NOT secret.
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_WHATSAPP_FROM=
# Shared secret embedded in the sender's Forward-to-HTTP URL path:
# https://<app>/webhook/infobip/<token>. Generate with:
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
INFOBIP_WEBHOOK_TOKEN=
# Optional approved template for sends outside the 24h user window.
INFOBIP_TEMPLATE_TEST_NAME=
INFOBIP_TEMPLATE_TEST_LANGUAGE=en
# Approved template for due reminders outside the 24h window (one body
# placeholder carrying the summary). Empty = reminders wait as blocked.
SISI_REMINDER_TEMPLATE=
SISI_REMINDER_TEMPLATE_LANG=en
# Lock ALL outbound sends to one provider (meta|vonage|infobip).
# Unset = reply on each message's own channel (current behavior).
# Set ONLY when ready to go live on that provider.
#SISI_PROVIDER=
SISI_DB=data/sisi.db
# Public base URL of the deployed app (Modal web endpoint). Needed to send
# month-end PDF/PNG files as WhatsApp media; without it files are saved only.
SISI_PUBLIC_URL=
SISI_REPORTS=data/reports
# Freeze "today" (YYYY-MM-DD) for a recorded demo, e.g. 2026-11-01. Leave blank for real date.
SISI_TODAY=
LOG_LEVEL=INFO
